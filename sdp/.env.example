# Template for sdp/.env. Do not fill this file in by hand: `npm run
# sdp:accounts` generates every secret with a cryptographic random source,
# funds the host distribution account on testnet, and writes sdp/.env with
# mode 600. sdp/.env is gitignored and must never be committed, pasted into
# a document or shown on a screenshot.
#
# Variable names come from dev/.env.example and cmd/serve.go at SDP tag
# 7.0.0. Testnet only.

# Compose project and database
COMPOSE_PROJECT_NAME=sdp-bridge
NETWORK_TYPE=testnet
DATABASE_NAME=sdp_mtn

# Stellar testnet
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# Ports and base URLs
PORT=8000
ADMIN_PORT=8003
BASE_URL=http://localhost:8000
SDP_UI_BASE_URL=http://localhost:3000

# Host distribution account (funds each tenant's distribution account with
# TENANT_XLM_BOOTSTRAP_AMOUNT XLM) and the SEP-10 signing account.
DISTRIBUTION_PUBLIC_KEY=
DISTRIBUTION_SEED=
SEP10_SIGNING_PUBLIC_KEY=
SEP10_SIGNING_PRIVATE_KEY=
TENANT_XLM_BOOTSTRAP_AMOUNT=5

# Encryption passphrases for the TSS vault. The SDP requires each to be a
# valid Stellar secret seed (cmd/utils/custom_set_value.go:164-172); the
# generator makes two fresh ones, unrelated to any account.
DISTRIBUTION_ACCOUNT_ENCRYPTION_PASSPHRASE=
CHANNEL_ACCOUNT_ENCRYPTION_PASSPHRASE=

# Admin (multi-tenant) API, Basic auth
ADMIN_ACCOUNT=SDP-admin
ADMIN_API_KEY=

# Dashboard session signing and SEP-24 JWT
SEP24_JWT_SECRET=
EC256_PRIVATE_KEY=

# Bridge tenant. The SDP creates the owner user with the tenant; sdp:up sets
# its password through the reset-password flow. Dashboard:
# http://bridge.localhost:3000 (the dashboard sends the first hostname
# label as the tenant name)
BRIDGE_TENANT_NAME=bridge
BRIDGE_ORGANIZATION_NAME=Bridge testnet tenant
BRIDGE_OWNER_EMAIL=owner@bridge.local
BRIDGE_OWNER_PASSWORD=

# Scope test tenant: exists only for the receiver scoping evidence
SCOPETEST_TENANT_NAME=scopetest
SCOPETEST_ORGANIZATION_NAME=Scope test tenant
SCOPETEST_OWNER_EMAIL=owner@scopetest.local
SCOPETEST_OWNER_PASSWORD=
