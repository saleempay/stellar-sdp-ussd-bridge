# Copy to .env and fill in. NEVER commit .env: it is gitignored.
# Everything in this repository is for Stellar TESTNET only.

# Network. These two describe the same network and change together.
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
FRIENDBOT_URL=https://friendbot.stellar.org

# Where the local SDP tenant listens (see sdp/docker-compose.yml).
SDP_API_URL=http://localhost:8000
SDP_ADMIN_URL=http://localhost:8003
SDP_UI_URL=http://localhost:3000

# SDP credentials live in sdp/.env, written by `npm run sdp:accounts`.
# Nothing secret belongs in this file.

# Deliverable 2: recipient provisioning (testnet only).
# The sponsor pays the reserves of every recipient account. It is a
# throwaway testnet account, separate from the SDP host account in
# sdp/.env. Create it with: npm run sponsor:setup
SPONSOR_PUBLIC_KEY=
SPONSOR_SECRET_KEY=
# The asset every recipient gets a trustline to. Testnet USDC issuer from
# the SDP source (see docs/sdp-setup.md section 4).
ASSET_CODE=USDC
ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Per-call deadline for Horizon, milliseconds.
HORIZON_TIMEOUT_MS=15000

# Deliverable 3: the USSD service (testnet only).
# Port the callback server listens on; expose it through your own tunnel.
USSD_PORT=8085
# REQUIRED, a capability credential: a long random segment, never logged,
# never committed, never pasted into a document. Generate 32 hex characters.
USSD_CALLBACK_PATH=/ussd/REPLACE-WITH-A-LONG-RANDOM-SEGMENT
# Optional CIDR allowlist for the callback; off when empty (sandbox).
USSD_ALLOWED_CIDRS=
# Country calling code for numbers the gateway delivers in national format.
USSD_DEFAULT_COUNTRY_CODE=254
# Absolute session TTL, milliseconds.
USSD_SESSION_TTL_MS=120000
# true: a number with no account gets one created on dial (demonstration
# build). false: operator-provisioned posture, such a number gets E3.
USSD_CREATE_ON_DIAL=true
# Directory holding accounts.json and pins.json (the Deliverable 2 stores).
DATA_DIR=data
# Live sandbox test only: the Deliverable 2 recipient to dial with, and the
# tunnel base URL shown in the banner. Set in the shell, not here.
# USSD_E2E_MSISDN=  TUNNEL_BASE_URL=
