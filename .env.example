# Copy to .env and fill in. NEVER commit .env: it is gitignored.
# Testnet is the only network this repository configures. The values below
# are the testnet ones and the only network literals in the repository.

# Network. Every process runs a boot assertion on these five values
# (src/sdp/network.ts): with NETWORK_TYPE unset or testnet, each one that
# is set must equal the testnet value. Any other network type needs all
# five supplied from outside this repository, none equal to a testnet
# value, and BRIDGE_ACKNOWLEDGE_REAL_FUNDS=yes; otherwise the process
# exits naming the missing or mismatched variable.
NETWORK_TYPE=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet
BRIDGE_ACKNOWLEDGE_REAL_FUNDS=
# Testnet only; `--no-fund` on the setup scripts skips it.
FRIENDBOT_URL=https://friendbot.stellar.org

# Where the local SDP tenant listens (see sdp/docker-compose.yml).
SDP_API_URL=http://localhost:8000
SDP_ADMIN_URL=http://localhost:8003
SDP_UI_URL=http://localhost:3000

# SDP credentials live in sdp/.env, written by `npm run sdp:accounts`.
# Nothing secret belongs in this file.

# Deliverable 2: recipient provisioning (testnet only).
# The sponsor pays the reserves of every recipient account. It is a
# throwaway testnet account, separate from the SDP host account in
# sdp/.env. Create it with: npm run sponsor:setup
SPONSOR_PUBLIC_KEY=
SPONSOR_SECRET_KEY=
# Optional: a signer supplied from outside this repository (an ES module
# path or specifier exporting createSigner or a default export that returns
# an object implementing the adapter's Signer interface: createAccountKey,
# canSignFor, signTransaction). Checked at boot. With it, SPONSOR_PUBLIC_KEY
# names the sponsor, the signer must be able to sign for it, and
# SPONSOR_SECRET_KEY must be empty. Unset: the adapter's reference signer.
BRIDGE_SIGNER_MODULE=
BRIDGE_SIGNER_EXPORT=
# Boot self-test of an injected signer: it signs a throwaway envelope for
# the sponsor (sequence 0, expired time bounds, never submittable) and the
# signature is verified against SPONSOR_PUBLIC_KEY. On by default on every
# network; off turns it off. The run is logged, the signature never.
BRIDGE_SIGNER_SELF_TEST=
# The asset every recipient gets a trustline to. Testnet USDC issuer from
# the SDP source (see docs/sdp-setup.md section 4). ASSET_ISSUER is one of
# the five network values checked by the boot assertion.
ASSET_CODE=USDC
ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Per-call deadline for Horizon, milliseconds.
HORIZON_TIMEOUT_MS=15000
# Caps applied to the input file before anything is created or written
# (rulings of 10 October 2026). Unset: the defaults shown. Positive
# decimals, at most 7 places.
MAX_PAYMENT_USDC=5
MAX_BATCH_USDC=25

# Deliverable 3: the USSD service (testnet only).
# Port the callback server listens on; expose it through your own tunnel.
USSD_PORT=8085
# REQUIRED, a capability credential: a long random segment, never logged,
# never committed, never pasted into a document. Generate 32 hex characters.
USSD_CALLBACK_PATH=/ussd/REPLACE-WITH-A-LONG-RANDOM-SEGMENT
# Optional CIDR allowlist for the callback; off when empty (sandbox).
USSD_ALLOWED_CIDRS=
# Source addresses of Africa's Talking USSD callbacks, as stated by
# Africa's Talking on 12 October 2026. Documented default only: the
# service does not read this variable yet (a later change rejects, and
# logs, every other source address). To enforce today, put the three in
# USSD_ALLOWED_CIDRS as /32 entries.
# AT_CALLBACK_ALLOWLIST=18.133.205.228,35.177.236.113,3.8.44.1
# Country calling code for numbers the gateway delivers in national format.
USSD_DEFAULT_COUNTRY_CODE=254
# Absolute session TTL, milliseconds.
USSD_SESSION_TTL_MS=120000
# Creation on dial is OFF unless this is exactly true (fail closed): a
# number with no account gets E3, the operator-provisioned posture. The
# demonstration environment sets true explicitly in its own .env. Every
# creation locks about 1.5 XLM of sponsor reserve the reference signer
# cannot reclaim, so creation is also capped (E3 when a cap is hit): the
# sponsor's spendable XLM floor and the number of creations per hour.
# Testnet only: on any other network type, true is refused at boot
# (src/ussd/server.ts); recipients are then provisioned by the operator.
USSD_CREATE_ON_DIAL=false
USSD_CREATE_MIN_SPONSOR_XLM=10
USSD_CREATE_MAX_PER_HOUR=5
# Directory holding accounts.json and pins.json (the Deliverable 2 stores).
DATA_DIR=data
# Public tunnel in front of the callback server, started by `npm run
# ussd:capture`. quick (default): a cloudflared quick tunnel, whose hostname
# changes on every start, so the gateway callback must be saved again after
# every start. named: a cloudflared named tunnel on the fixed hostname
# below, with either the tunnel token (remotely managed) or the tunnel name
# (locally managed; needs a domain on Cloudflare). external: a tunnel you
# run yourself, passed with --tunnel-url. See docs/integration-guide.md.
USSD_TUNNEL_MODE=quick
USSD_TUNNEL_HOSTNAME=
USSD_TUNNEL_TOKEN=
USSD_TUNNEL_NAME=
# Closing line of screens 7 and 8. Unset or blank: the contracted text,
# "Test only, no funds move". Any other value is a menu change that needs
# written notice to Africa's Talking before production. Refused at boot
# when it breaks the screen budget or is not printable ASCII.
USSD_CLOSING_LINE=
# Live sandbox test only: the Deliverable 2 recipient to dial with, and the
# tunnel base URL shown in the banner. Set in the shell, not here.
# USSD_E2E_MSISDN=  TUNNEL_BASE_URL=
